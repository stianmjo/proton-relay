# Example ExternalSecret for the proton-relay ClusterSecretStore.
# Copy it to a .yaml file and adjust. It is .example so `kubectl apply -f deploy/` skips it.
#
# remoteRef.key format:  <ItemTitle>/<field>
#
# Served item types (ALLOWED_ITEM_TYPES, default Login,Note,Custom):
#   Login:            username, password, email, urls, url (first URL), totp / totp_uri (otpauth:// URI)
#   Custom:           <Section>.<field>, or just <field> if the name is unique across sections
#   Note:             no extra fields beyond the ones below
#   SshKey (opt-in):  private_key, public_key
#   Every item:       title, note, and any custom field you added to the item
# Credit card, Wifi and Identity items are refused (403).
#
# Names are case-insensitive. Empty built-in fields return 404.
# Discover an item's exact field names:  GET /fields/<ItemTitle>
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: postgres
  namespace: my-app
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: proton-relay
  target:
    name: postgres
    creationPolicy: Owner
  data:
    # Login item "postgres": built-in fields
    - secretKey: username
      remoteRef:
        key: "postgres/username"
    - secretKey: password
      remoteRef:
        key: "postgres/password"
    # Custom hidden field added to the same item
    - secretKey: api-key
      remoteRef:
        key: "postgres/api-key"
    # Custom item "cloudflare-api": field "token" in section "API"
    - secretKey: cloudflare-token
      remoteRef:
        key: "cloudflare-api/API.token"
