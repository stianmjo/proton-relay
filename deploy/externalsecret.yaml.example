# Example ExternalSecret. Copy to a .yaml file and edit.
#
# Key format:
#   <folder>/<item>/<field>   item in that folder (nested: a/b/item/field)
#   <item>/<field>            item at the vault root
#   id:<ItemID>/<field>       item by ID, in any folder
#
# Find an item's ID and fields: GET /fields/<folder>/<item>
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: postgres
  namespace: my-app
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: proton-relay
  target:
    name: postgres
    creationPolicy: Owner
  data:
    # Login item "postgres" in folder "my-app"
    - secretKey: username
      remoteRef:
        key: "my-app/postgres/username"
    - secretKey: password
      remoteRef:
        key: "my-app/postgres/password"

    # Custom field "api-key" on the same item
    - secretKey: api-key
      remoteRef:
        key: "my-app/postgres/api-key"

    # Custom item "cloudflare" at the vault root, field "token" in section "API"
    - secretKey: cloudflare-token
      remoteRef:
        key: "cloudflare/API.token"

    # Any item by ID
    - secretKey: smtp-password
      remoteRef:
        key: "id:<ItemID>/password"
