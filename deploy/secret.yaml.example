# Example of the Secret the relay needs. Never commit the real one.
# Easier: create it with the kubectl command in the README.
apiVersion: v1
kind: Secret
metadata:
  name: proton-relay
  namespace: external-secrets
  labels:
    external-secrets.io/type: webhook
type: Opaque
stringData:
  # From: pass-cli pat create --name "my-cluster-eso" --expiration 1y
  # Then: pass-cli pat access grant --pat-name "my-cluster-eso" --vault-name "Kubernetes" --role viewer
  PROTON_PASS_PERSONAL_ACCESS_TOKEN: "pst_xxxx::xxxx"

  # Any random string, e.g. from: openssl rand -hex 32
  BRIDGE_TOKEN: "change-me"
